name: dockercompose6479468441018959454
services:
  frontend:
    build:
      context: C:\Users\Kiren\source\repos\SmartPlanner\frontendplanner
      dockerfile: Dockerfile
    container_name: smartplanner-frontend
    depends_on:
      smartplanner:
        condition: service_started
        required: true
    image: smartplanner-frontend
    networks:
      default: null
    ports:
      - mode: ingress
        target: 80
        published: "5173"
        protocol: tcp
  smartplanner:
    build:
      context: C:\Users\Kiren\source\repos\SmartPlanner
      dockerfile: SmartPlanner/Dockerfile
    container_name: smartplanner-backend
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "8080"
      ASPNETCORE_HTTPS_PORTS: "8081"
      ASPNETCORE_URLS: http://+:80
    image: smartplanner
    networks:
      default: null
    ports:
      - mode: ingress
        target: 80
        published: "5058"
        protocol: tcp
      - mode: ingress
        target: 8080
        protocol: tcp
      - mode: ingress
        target: 8081
        protocol: tcp
    volumes:
      - type: bind
        source: C:\Users\Kiren\AppData\Roaming/Microsoft/UserSecrets
        target: /home/app/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Kiren\AppData\Roaming/Microsoft/UserSecrets
        target: /root/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Kiren\AppData\Roaming/ASP.NET/Https
        target: /home/app/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Kiren\AppData\Roaming/ASP.NET/Https
        target: /root/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
networks:
  default:
    name: dockercompose6479468441018959454_default