name: dockercompose6479468441018959454
services:
  frontend:
    build:
      context: C:\Users\Kiren\source\repos\SmartPlanner\frontendplanner
      dockerfile: Dockerfile
    container_name: smartplanner-frontend
    depends_on:
      smartplanner:
        condition: service_started
        required: true
    image: smartplanner-frontend
    networks:
      app-network: null
    ports:
      - mode: ingress
        target: 80
        published: "5173"
        protocol: tcp
  postgres:
    container_name: smartplanner-postgres
    environment:
      POSTGRES_DB: smartplanner
      POSTGRES_PASSWORD: 3nQ9ohWI7wGmvqD
      POSTGRES_USER: postgres
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U postgres
      timeout: 5s
      interval: 5s
      retries: 5
    image: postgres:15
    networks:
      app-network: null
    ports:
      - mode: ingress
        target: 5432
        published: "5433"
        protocol: tcp
    volumes:
      - type: volume
        source: postgres_data
        target: /var/lib/postgresql/data
        volume: {}
  smartplanner:
    build:
      context: C:\Users\Kiren\source\repos\SmartPlanner
      dockerfile: SmartPlanner/Dockerfile
      args:
        BUILD_CONFIGURATION: Debug
        LAUNCHING_FROM_VS: "true"
      labels:
        com.microsoft.created-by: visual-studio
        com.microsoft.visual-studio.project-name: SmartPlanner
    container_name: smartplanner-backend
    depends_on:
      postgres:
        condition: service_healthy
        required: true
    entrypoint:
      - dotnet
      - --roll-forward
      - Major
      - /VSTools/DistrolessHelper/DistrolessHelper.dll
      - --wait
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "8080"
      ASPNETCORE_HTTPS_PORTS: "8081"
      ASPNETCORE_URLS: http://+:80
      ConnectionStrings__Default: Host=postgres;Port=5432;Database=smartplanner;Username=postgres;Password=3nQ9ohWI7wGmvqD
      Jwt__Key: MjBjOGNiMTQtOWViOS00NzhhLWE4ZTQtMTJjNzk2ZTc5MjlmNDIyYmI3OGMtYWU0NS00Yjg1LThmYTktNTBlOTU1Mjk2YTRhYzk4ZTE5ZjQtMDEwNy00M2NjLWIzM2YtMzUzMjRkZjlhNGNm
    image: smartplanner
    labels:
      com.microsoft.visual-studio.project-name: SmartPlanner
      com.microsoft.visualstudio.debuggee.arguments: ' --additionalProbingPath /.nuget/packages --additionalProbingPath /.nuget/fallbackpackages  "/app/SmartPlanner.dll"'
      com.microsoft.visualstudio.debuggee.killprogram: dotnet --roll-forward Major /VSTools/DistrolessHelper/DistrolessHelper.dll --stop dotnet
      com.microsoft.visualstudio.debuggee.program: dotnet
      com.microsoft.visualstudio.debuggee.workingdirectory: /app
    networks:
      app-network: null
    ports:
      - mode: ingress
        target: 80
        published: "5058"
        protocol: tcp
      - mode: ingress
        target: 8080
        protocol: tcp
      - mode: ingress
        target: 8081
        protocol: tcp
    tty: true
    volumes:
      - type: bind
        source: C:\Users\Kiren\AppData\Roaming\Microsoft\UserSecrets
        target: /home/app/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Kiren\AppData\Roaming\Microsoft\UserSecrets
        target: /root/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Kiren\AppData\Roaming\ASP.NET\Https
        target: /home/app/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Kiren\AppData\Roaming\ASP.NET\Https
        target: /root/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Kiren\vsdbg\vs2017u5
        target: /remote_debugger
        bind:
          create_host_path: true
      - type: bind
        source: C:\Program Files\Microsoft Visual Studio\2022\Community\MSBuild\Sdks\Microsoft.Docker.Sdk\tools\linux-x64\net8.0
        target: /VSTools
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Program Files\Microsoft Visual Studio\2022\Community\Common7\IDE\CommonExtensions\Microsoft\HotReload
        target: /HotReloadAgent
        read_only: true
        bind:
          create_host_path: true
networks:
  app-network:
    name: dockercompose6479468441018959454_app-network
    driver: bridge
volumes:
  postgres_data:
    name: dockercompose6479468441018959454_postgres_data